{
  "$id": "https://w3id.org/kim/amb/draft/schemas/suggestedAge.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Suggested Age",
  "description": "The recommended age of the target audience for the resource.",
  "type": "object",
  "properties": {
    "minValue": {
      "title": "minValue",
      "type": "integer"
    },
    "maxValue": {
      "title": "maxValue",
      "type": "integer"
    }
  },
  "anyOf": [
    {
      "required": ["minValue"]
    },
    {
      "required": ["maxValue"]
    }
  ]
}
