{
  "$id": "https://w3id.org/kim/amb/draft/schemas/provider.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Provider",
  "description": "A source that provides the educational resource or it metadata",
  "type": "object",
  "properties": {
    "id": {
      "title": "URL",
      "type": "string",
      "format": "uri"
    },
    "type": {
      "title": "Type",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    }
  },
  "required": ["id"]
}
